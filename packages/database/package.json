{
  "name": "@arrival/database",
  "version": "0.1.0",
  "private": true,
  "description": "Database migrations, schema definitions, and migration tooling for Project Arrival",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "migrate": "node dist/cli.js up",
    "rollback": "node dist/cli.js down",
    "validate": "node dist/cli.js validate"
  },
  "dependencies": {
    "@arrival/contracts": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^24.11.1",
    "@types/pg": "^8.11.11",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
